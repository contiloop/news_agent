<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.inertia.news-agent-watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USER/Desktop/news_agent/.venv/bin/news-agent</string>
        <string>watchdog-once</string>
        <string>--config</string>
        <string>/Users/YOUR_USER/Desktop/news_agent/config/reuters.toml</string>
        <string>--service-label</string>
        <string>com.inertia.news-agent-reuters</string>
        <string>--run-log</string>
        <string>/Users/YOUR_USER/Library/Logs/news-agent.reuters.run-once.stderr.log</string>
        <string>--state-file</string>
        <string>/Users/YOUR_USER/Desktop/news_agent/data/reuters-watchdog.json</string>
        <string>--quiet-when-idle</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USER/Desktop/news_agent</string>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USER/Library/Logs/news-agent.watchdog.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USER/Library/Logs/news-agent.watchdog.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONDONTWRITEBYTECODE</key>
        <string>1</string>
    </dict>

    <key>Umask</key>
    <integer>63</integer>
</dict>
</plist>
